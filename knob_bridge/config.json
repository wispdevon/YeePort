{
  "name": "YeeGate S Knob",
  "version": "0.6.1",
  "slug": "yeegate_knob",
  "description": "Local S Knob authenticated brightness/power control, MQTT actions, clock and weather",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "manual",
  "host_network": true,
  "host_dbus": true,
  "hassio_api": true,
  "services": [
    "mqtt:need"
  ],
  "privileged": [
    "NET_ADMIN",
    "NET_RAW"
  ],
  "apparmor": false,
  "options": {
    "address": "F8:24:41:39:9F:38",
    "adapter": "hci0",
    "name": "Knob",
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_tls": false,
    "clock_sync_enabled": true,
    "timezone": "Asia/Bangkok",
    "clock_sync_interval": 3600,
    "weather_sync_enabled": true,
    "weather_entity": "weather.forecast_home",
    "mesh_net_key": "",
    "mesh_app_key": "",
    "mesh_iv_index": 0,
    "mesh_unicast_address": 0,
    "mesh_destination": 65278,
    "light_control_enabled": false,
    "light_entity": "light.knob_lights",
    "color_controls_enabled": false,
    "brightness_speed_scaling": false,
    "brightness_maximum_gain": 4,
    "separate_brightness_controls": false,
    "warm_white_kelvin": 2700,
    "preset_scene": "scene.usual_red_10",
    "independent_channels": true
  },
  "schema": {
    "address": "match(^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$)",
    "adapter": "match(^hci[0-9]+$)",
    "name": "str",
    "mqtt_host": "str?",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_tls": "bool",
    "clock_sync_enabled": "bool",
    "timezone": "str",
    "clock_sync_interval": "int(300,86400)",
    "weather_sync_enabled": "bool",
    "weather_entity": "match(^weather\\.[a-z0-9_]+$)",
    "mesh_net_key": "password?",
    "mesh_app_key": "password?",
    "mesh_iv_index": "int(0,4294967295)",
    "mesh_unicast_address": "int(0,32767)",
    "mesh_destination": "int(1,65535)",
    "light_control_enabled": "bool",
    "light_entity": "match(^light\\.[a-z0-9_]+$)",
    "color_controls_enabled": "bool",
    "brightness_speed_scaling": "bool",
    "brightness_maximum_gain": "int(1,8)",
    "separate_brightness_controls": "bool",
    "warm_white_kelvin": "int(1000,10000)",
    "preset_scene": "match(^scene\\.[a-z0-9_]+$)",
    "independent_channels": "bool"
  },
  "homeassistant_api": true,
  "map": [
    {
      "type": "share",
      "read_only": false
    }
  ]
}
